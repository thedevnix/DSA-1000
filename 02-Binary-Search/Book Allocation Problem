class Solution {
public:
    bool isPossible(vector<int>&nums,int mid,int m){
        int student = 1;
        long long pageStudent = 0;

        for(int i=0;i<nums.size();i++){
            if(nums[i]+pageStudent<=mid){
                pageStudent+=nums[i];
            }
            else{
                student+=1;
                pageStudent=nums[i];
            }
        }

        return student<=m;
    }
    int findPages(vector<int> &nums, int m)  {
        int n = nums.size();
        if(m>n) return -1;
        int s = *max_element(begin(nums),end(nums));
        int e = accumulate(nums.begin(),nums.end(),0);
        int ans = -1;
        while(s<=e){
            long long mid = s+(e-s)/2;
            if(isPossible(nums,mid,m)){
                ans = mid;
                e = mid-1;
            }
            else{
                s = mid+1;
            }
        }
        return ans;
        
    }
};
