class Solution {
public:
    vector<int> searchRange(vector<int> nums, int x) {
        int n = nums.size();
        int s=0;
        int e = n-1;
        int floor = -1;
        int ceil = -1;
        while(s<=e){
            int mid = s+(e-s)/2;
            if(nums[mid]<=x){
                floor = nums[mid];
                s = mid+1;
            }
            else{
                e = mid-1;
            }
        }
         
         //process for finding the ceil of the array using binary search

         s = 0 , e = n-1;
         while(s<=e){
            int mid = s+(e-s)/2;
            if(nums[mid]>=x){
                ceil = nums[mid];
                e = mid-1;
            }
            else {
                s = mid+1;
            }
         }

         return {floor , ceil};
   
    }
};
