class Solution {
public:
    int threeSumSmaller(vector<int>& nums, int target) {
        int n= nums.size();
        int ans = 0;
        sort(begin(nums),end(nums));
        for(int i=0;i<n-2;i++){
            int j = i+1;
            int k=n-1;
            while(j<k){
                int sum = nums[i]+nums[j]+nums[k];
                if(sum>=target){
                    k--;
                }
                else if(sum<target){
                    ans = ans+(k-j);
                    j++;
                }
            }
        }

        return ans;
        
    }
};
